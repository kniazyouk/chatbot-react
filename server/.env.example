# Groq (gratis, sin tarjeta) — https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Modelo Groq (opcional, default: llama-3.1-70b-versatile)
# GROQ_MODEL=llama-3.1-70b-versatile

# WhatsApp Cloud API (Meta)
WHATSAPP_PHONE_ID=your_phone_id_here
WHATSAPP_ACCESS_TOKEN=your_access_token_here
WHATSAPP_AGENT_NUMBER=your_agent_number_here
WHATSAPP_VERIFY_TOKEN=your_webhook_verify_token_here

# Frontend URL (for CORS)
FRONTEND_URL=https://your-frontend.onrender.com

# Port (Render lo asigna automaticamente, opcional)
# PORT=3001

# Rate Limiting (API Chat - protege consumo de tokens de Groq)
# RATE_LIMIT_WINDOW_MS=10000   # ventana en milisegundos (default: 10s)
# RATE_LIMIT_MAX_HITS=5        # max peticiones por ventana (default: 5)

# Render: habilita pnpm en vez de npm
# RENDER_PNPM_ENABLED=true
